# Stage 0: llama-index-core v0.14.19 (Original Vulnerable)
# Both download_dataset_and_source_files() AND SimpleKVStore.persist() are exploitable

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV LAB_STAGE=0

RUN apt-get update && apt-get install -y curl jq && rm -rf /var/lib/apt/lists/*

# Install the original vulnerable version
RUN pip install --no-cache-dir llama-index-core==0.14.19 flask

# Create sandbox data directory
RUN mkdir -p /app/sandbox_data

# Copy server code
COPY app/ /app/app/

EXPOSE 8000

ENTRYPOINT ["python", "-u", "/app/app/server.py"]
